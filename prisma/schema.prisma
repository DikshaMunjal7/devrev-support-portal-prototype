generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Ticket {
  id            String   @id @default(uuid())
  title         String
  description   String
  priority      String
  status        String
  category      String
  customerEmail String
  customer      String?
  aiSummary     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
